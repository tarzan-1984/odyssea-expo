{
  "expo": {
    "name": "Odysseia App",
    "slug": "odyssea",
    "version": "2.2.6",
    "orientation": "portrait",
    "icon": "./assets/android-adaptive-icon.png",
    "scheme": "odyssea",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#292966"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.odyssea.app",
      "icon": "./assets/android-adaptive-icon.png",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#292966"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses location to share your current location and update it automatically.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses location to share your current location and update it automatically in the background.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select an avatar and save chat images.",
        "NSPhotoLibraryAddUsageDescription": "This app saves images from chat to your photo library.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "file"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "versionCode": 38,
      "package": "com.odyssea.app",
      "googleServicesFile": "./google-services.json",
      "notification": {
        "icon": "./assets/images/notification-icon.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#292966"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/livechat.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app uses location to share your current location and update it automatically.",
          "locationAlwaysPermission": "This app uses location to share your current location and update it automatically in the background.",
          "locationWhenInUsePermission": "This app uses location to share your current location and update it automatically."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "googleServicesFile": "./google-services.json",
            "usesCleartextTraffic": true,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-asset",
      "expo-web-browser",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Odyssea to access your photos.",
          "savePhotosPermission": "Allow Odyssea to save images from chat to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "iosAppStoreUrl": "https://apps.apple.com/app/id6756887777",
      "eas": {
        "projectId": "d95b9117-4914-4642-ae1d-a6d37a32ec26"
      }
    }
  }
}
